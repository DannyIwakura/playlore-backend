# PlayRole Backend — Variables de entorno requeridas
# Copia este archivo como .env y rellena los valores.

# Base de datos MySQL
DB_URL=jdbc:mysql://localhost:3306/playlore_db
DB_USER=root
DB_PASS=root
DB_DDL_AUTO=update

# JWT (OBLIGATORIO en producción — la app falla al arrancar si falta)
JWT_SECRET=

# reCAPTCHA (Google)
# En dev: el perfil dev usa la clave de prueba de Google por defecto.
# En prod: obtener la clave secreta en https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=
RECAPTCHA_SKIP_VERIFICATION=false

# Google OAuth (Sign in with Google)
# Obtener el client-id en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# CORS: orígenes permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Puerto del servidor (default: 8080)
PORT=8080

# Perfil de Spring (dev / test / prod)
SPRING_PROFILES_ACTIVE=dev
